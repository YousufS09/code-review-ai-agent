NODE_ENV=development
PORT=3000

DATABASE_URL=
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CORS_ORIGIN=http://localhost:3000

# Optional settings (defaults shown)
# Comma-separated GitHub users/orgs allowed to use the app. Empty allows every installation.
ALLOWED_GITHUB_OWNERS=
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_MS=90000
GITHUB_TIMEOUT_MS=20000
REVIEW_MAX_PROMPT_CHARS=40000
REVIEW_MAX_PATCH_CHARS=6000
# Extra comma-separated globs to skip, e.g. docs/**,*.generated.ts
REVIEW_IGNORE_PATTERNS=
REVIEW_MIN_SEVERITY=low
REVIEW_DRAFTS=false
WEBHOOK_RETENTION_DAYS=30
